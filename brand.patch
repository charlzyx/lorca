index 0000000000000000000000000000000000000000..bcb46d70054979afad0e5ed7f17adad266617dd2
--- /dev/null
+++ b/crates/cli/tests/mcp_path.rs
@@ -0,0 +1,69 @@
+#![cfg(all(feature = "runner", unix))]
+
+use std::path::PathBuf;
+use std::process::Command;
+
+use lorca::app::App;
+use lorca::config::Config;
+use lorca::plugins::mcp_json;
+use serde_json::json;
+
+/// A subprocess isolates HOME from other tests and never opens the real user's MCP config.
+#[test]
+fn branded_mcp_reads_and_writes_in_a_temporary_home() {
+    const CHILD: &str = "DOTS_MCP_PATH_TEST_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        let home = std::env::temp_dir().join(format!("dots-mcp-path-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(&home).unwrap();
+        let output = Command::new(std::env::current_exe().unwrap())
+            .env_clear()
+            .env("HOME", &home)
+            .env(CHILD, "1")
+            .args(["--exact", "branded_mcp_reads_and_writes_in_a_temporary_home", "--nocapture"])
+            .output()
+            .unwrap();
+        let _ = std::fs::remove_dir_all(home);
+        assert!(output.status.success(), "{}\n{}", String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+        return;
+    }
+
+    let home = PathBuf::from(std::env::var_os("HOME").unwrap());
+    let config = Config::load(None, Some(0));
+    assert_eq!(config.home, home.join(".lorca"));
+    assert_eq!(config.identity_path(), home.join(".lorca/identity.json"));
+    assert_eq!(config.credentials_path(), home.join(".lorca/credentials.json"));
+    assert_eq!(config.plugins_dir(), home.join(".lorca/plugins"));
+    assert_eq!(config.mcp_path(), home.join(".dots/mcp.json"));
+
+    std::fs::create_dir_all(&config.home).unwrap();
+    let legacy = config.home.join("mcp.json");
+    std::fs::write(&legacy, b"legacy config is neither read nor overwritten").unwrap();
+    let app = App::load(config.clone()).unwrap();
+    assert!(!config.mcp_path().exists(), "reading a missing MCP file does not create it");
+    let list = mcp_json::list(&app);
+    assert_eq!(list["path"], json!(config.mcp_path()));
+    assert!(list["error"].is_null());
+    assert_eq!(list["servers"], json!([]));
+
+    // A disabled entry tests persistence without executing any command or using the network.
+    mcp_json::save(&app, "fixture", None, &json!({"command": "never-executed", "disabled": true})).unwrap();
+    use std::os::unix::fs::PermissionsExt;
+    assert_eq!(std::fs::metadata(config.mcp_path()).unwrap().permissions().mode() & 0o777, 0o600);
+    let saved: serde_json::Value = serde_json::from_slice(&std::fs::read(config.mcp_path()).unwrap()).unwrap();
+    assert_eq!(saved["mcpServers"]["fixture"]["command"], "never-executed");
+    assert_eq!(mcp_json::get(&app, "fixture").unwrap()["path"], json!(config.mcp_path()));
+    drop(app);
+
+    let app = App::load(config.clone()).unwrap();
+    assert_eq!(mcp_json::list(&app)["servers"][0]["name"], "fixture", "startup reads the branded path");
+    mcp_json::remove(&app, "fixture").unwrap();
+    let removed: serde_json::Value = serde_json::from_slice(&std::fs::read(config.mcp_path()).unwrap()).unwrap();
+    assert!(removed["mcpServers"].get("fixture").is_none());
+    assert_eq!(std::fs::read(&legacy).unwrap(), b"legacy config is neither read nor overwritten");
+    assert!(!home.join(".dots/identity.json").exists());
+
+    let isolated = Config::load(Some(home.join("isolated")), Some(0));
+    assert_eq!(isolated.mcp_path(), home.join("isolated/mcp.json"));
+    let dev = Config::load(Some(home.join(".lorca-dev")), Some(0));
+    assert_eq!(dev.mcp_path(), home.join(".lorca-dev/mcp.json"));
+}
