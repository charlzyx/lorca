index 0000000..9eff66f
--- /dev/null
+++ b/crates/cli/tests/mcp_path.rs
@@ -0,0 +1,141 @@
+#![cfg(all(feature = "runner", unix))]
+
+use std::path::PathBuf;
+use std::process::Command;
+
+use lorca::app::App;
+use lorca::config::{Config, Settings, write_json_private};
+use lorca::keys::{Identity, IdentityFile};
+use lorca::plugins::mcp_json;
+use serde_json::json;
+
+/// A subprocess isolates HOME from other tests and never opens the real user's MCP config.
+#[test]
+fn branded_account_reads_and_writes_in_a_temporary_home() {
+    const CHILD: &str = "DOTS_MCP_PATH_TEST_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        let home = std::env::temp_dir().join(format!("dots-mcp-path-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir_all(&home).unwrap();
+        let output = Command::new(std::env::current_exe().unwrap())
+            .env_clear()
+            .env("HOME", &home)
+            .env(CHILD, "1")
+            .args(["--exact", "branded_account_reads_and_writes_in_a_temporary_home", "--nocapture"])
+            .output()
+            .unwrap();
+        let _ = std::fs::remove_dir_all(home);
+        assert!(output.status.success(), "{}\n{}", String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+        return;
+    }
+
+    let home = PathBuf::from(std::env::var_os("HOME").unwrap());
+    let config = Config::load(None, Some(0));
+    assert_eq!(config.home, home.join(".dots"));
+    assert_eq!(config.identity_path(), home.join(".dots/identity.json"));
+    assert_eq!(config.credentials_path(), home.join(".dots/credentials.json"));
+    assert_eq!(config.plugins_dir(), home.join(".dots/plugins"));
+    assert_eq!(config.mcp_path(), home.join(".dots/mcp.json"));
+
+    // Seed a separate legacy account. The default must neither load nor mutate it.
+    let legacy = home.join(".lorca");
+    std::fs::create_dir_all(&legacy).unwrap();
+    let legacy_settings = br#"{"relay_url":"http://legacy.invalid"}"#;
+    std::fs::write(legacy.join("settings.json"), legacy_settings).unwrap();
+    std::fs::write(legacy.join("mcp.json"), b"legacy config is neither read nor overwritten").unwrap();
+    std::fs::write(legacy.join("lorca.sqlite3"), b"legacy database must never be opened").unwrap();
+    std::fs::write(legacy.join("state.json"), b"legacy state must never be deleted").unwrap();
+    assert_eq!(config.machine_path(), config.home.join("machine.json"));
+    assert_eq!(config.database_path(), config.home.join("lorca.sqlite3"));
+    assert_eq!(config.settings_path(), config.home.join("settings.json"));
+    assert_eq!(config.files_dir(), config.home.join("files"));
+    assert_eq!(config.catalog_path(), config.home.join("catalog.json"));
+    assert_eq!(config.marketplace_path(), config.home.join("marketplace.json"));
+    assert_eq!(config.update_path(), config.home.join("update.json"));
+    let app = App::load(config.clone()).unwrap();
+    assert!(app.identity.lock().unwrap().is_none());
+    assert!(app.settings.lock().unwrap().relay_url.is_none());
+    assert!(config.database_path().is_file());
+    let identity = IdentityFile::new(&Identity::generate());
+    write_json_private(&config.identity_path(), &identity).unwrap();
+    Settings { relay_url: Some("http://dots.invalid".into()), auto_update: Some(false) }.save(&config).unwrap();
+    write_json_private(&config.credentials_path(), &json!({})).unwrap();
+    assert!(!config.mcp_path().exists(), "reading a missing MCP file does not create it");
+    let list = mcp_json::list(&app);
+    assert_eq!(list["path"], json!(config.mcp_path()));
+    assert!(list["error"].is_null());
+    assert_eq!(list["servers"], json!([]));
+
+    // A disabled entry tests persistence without executing any command or using the network.
+    mcp_json::save(&app, "fixture", None, &json!({"command": "never-executed", "disabled": true})).unwrap();
+    use std::os::unix::fs::PermissionsExt;
+    assert_eq!(std::fs::metadata(&config.home).unwrap().permissions().mode() & 0o777, 0o700);
+    for path in [config.mcp_path(), config.identity_path(), config.credentials_path(), config.settings_path(), config.database_path()] {
+        assert_eq!(std::fs::metadata(path).unwrap().permissions().mode() & 0o777, 0o600);
+    }
+    let saved: serde_json::Value = serde_json::from_slice(&std::fs::read(config.mcp_path()).unwrap()).unwrap();
+    assert_eq!(saved["mcpServers"]["fixture"]["command"], "never-executed");
+    assert_eq!(mcp_json::get(&app, "fixture").unwrap()["path"], json!(config.mcp_path()));
+    drop(app);
+
+    let app = App::load(config.clone()).unwrap();
+    assert_eq!(app.identity.lock().unwrap().as_ref().unwrap().master_secret, identity.master_secret);
+    assert_eq!(app.settings.lock().unwrap().relay_url.as_deref(), Some("http://dots.invalid"));
+    assert_eq!(mcp_json::list(&app)["servers"][0]["name"], "fixture", "startup reads the branded path");
+    mcp_json::remove(&app, "fixture").unwrap();
+    let removed: serde_json::Value = serde_json::from_slice(&std::fs::read(config.mcp_path()).unwrap()).unwrap();
+    assert!(removed["mcpServers"].get("fixture").is_none());
+    assert_eq!(std::fs::read(legacy.join("mcp.json")).unwrap(), b"legacy config is neither read nor overwritten");
+    assert_eq!(std::fs::read(legacy.join("settings.json")).unwrap(), legacy_settings);
+    assert_eq!(std::fs::read(legacy.join("lorca.sqlite3")).unwrap(), b"legacy database must never be opened");
+    assert_eq!(std::fs::read(legacy.join("state.json")).unwrap(), b"legacy state must never be deleted");
+    assert!(!legacy.join("identity.json").exists());
+
+    let isolated = Config::load(Some(home.join("isolated")), Some(0));
+    assert_eq!(isolated.mcp_path(), home.join("isolated/mcp.json"));
+    let dev = Config::load(Some(home.join(".dots-dev")), Some(0));
+    assert_eq!(dev.mcp_path(), home.join(".dots-dev/mcp.json"));
+    // Launchers always pass LORCA_HOME. Exercise production and development launches,
+    // including persistence and the returned path the Settings UI actually displays.
+    for root in [".dots", ".dots-dev"] {
+        let launch_home = home.join(root);
+        std::env::set_var("LORCA_HOME", &launch_home);
+        let launched = Config::load(None, Some(0));
+        assert_eq!(launched.home, launch_home);
+        let launched_app = App::load(launched.clone()).unwrap();
+        mcp_json::save(&launched_app, "launcher", None, &json!({"command": "never-executed", "disabled": true})).unwrap();
+        assert_eq!(mcp_json::list(&launched_app)["path"], json!(launch_home.join("mcp.json")));
+        drop(launched_app);
+        let restarted = App::load(Config::load(None, Some(0))).unwrap();
+        assert_eq!(mcp_json::get(&restarted, "launcher").unwrap()["path"], json!(launch_home.join("mcp.json")));
+    }
+    // Explicit old and custom homes retain their exact meaning, including MCP.
+    std::env::set_var("LORCA_HOME", &legacy);
+    let explicit_legacy = Config::load(None, Some(0));
+    assert_eq!(explicit_legacy.home, legacy);
+    assert_eq!(explicit_legacy.mcp_path(), legacy.join("mcp.json"));
+    let custom = home.join("custom-env");
+    std::env::set_var("LORCA_HOME", &custom);
+    assert_eq!(Config::load(None, Some(0)).home, custom);
+    assert_eq!(Config::load(Some(home.join("flag-wins")), Some(0)).home, home.join("flag-wins"));
+    std::env::remove_var("LORCA_HOME");
+}
+
+/// Linux CI checks the actual Mac/Go launch-site contract without pretending to run AppKit.
