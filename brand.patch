+fn desktop_launchers_pass_the_branded_home_and_preserve_overrides() {
+    let mac_info = include_str!("../../../macos/Sources/Lorca/App/AppInfo.swift");
+    assert!(mac_info.contains("isDevelopment ? \".dots-dev\" : \".dots\""));
+    assert!(mac_info.contains("dots serve --home ~/.dots-dev --port 4863"));
